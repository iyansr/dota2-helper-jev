# TypeSafe API key — main process only, never exposed to the renderer.
TYPESAFE_API_KEY=

# Set to 1 to enable Jev composite ranking. Unset/0 = code-only baseline.
ENABLE_JEV=0

# Jev exchange logging. On by default whenever a request is made:
#   logs/jev-<start>.jsonl  gets the full state, questions and answers
#   the terminal gets a one-line summary per request
# JEV_LOG=0          turn the log off entirely
# JEV_LOG_CONSOLE=0  keep the file, silence the terminal (use this during a real game)
